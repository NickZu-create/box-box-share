# Production only. Never commit .env. Run locally without .env using DEBUG=1.
DOMAIN=share.example.org
ACME_EMAIL=operator@example.org
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
ALLOWED_HOSTS=share.example.org
CSRF_TRUSTED_ORIGINS=https://share.example.org
ALLOWED_EMAIL_DOMAINS=my.cityu.edu.hk
POSTGRES_DB=cityushare
POSTGRES_USER=cityushare
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=REPLACE_SMTP_USER
EMAIL_HOST_PASSWORD=REPLACE_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=Box Box Share <login@share.example.org>
# AI listing drafts. Leave AI_API_KEY empty to turn the feature off. Key from https://open.bigmodel.cn
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.6v-flash
# Share of borrows assumed to replace a purchase, for the impact page estimate.
CARBON_AVOIDED_PURCHASE_RATE=0.25
# Days a GPA proof file is kept after a reviewer decides; cleanup_auth deletes older ones.
GPA_PROOF_RETENTION_DAYS=14
